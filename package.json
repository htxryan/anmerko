{
  "name": "anmerko",
  "version": "0.5.3",
  "private": true,
  "type": "module",
  "description": "Turn website comments into an AI-ready brief.",
  "scripts": {
    "build": "node scripts/extension/build.mjs",
    "chrome:install": "node scripts/browsers/install-chrome.mjs",
    "test:installer": "node --test tests/tooling/*.test.mjs",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "playwright test -c tests/playwright.config.ts",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:installer && npm test",
    "demo": "node scripts/browsers/demo.mjs",
    "package": "npm run build && node scripts/extension/package.mjs",
    "site:build": "astro build --root site && node scripts/site/build-site.mjs && npm run support:build",
    "site:dev": "node scripts/site/serve-site.mjs",
    "site:check": "node --test tests/support/*.test.mjs",
    "site:test": "playwright test -c tests/playwright.site.config.ts",
    "site:preview": "node scripts/deployment/deploy-site-preview.mjs",
    "site:deploy": "wrangler deploy --config site/wrangler.jsonc",
    "support:build": "node scripts/site/build-support-site.mjs",
    "support:deploy": "npm run support:build && wrangler deploy --config site/support/wrangler.jsonc",
    "build:orion": "node scripts/extension/build.mjs --target orion",
    "package:orion": "npm run build:orion && node scripts/extension/package.mjs --target orion",
    "build:firefox": "node scripts/extension/build.mjs --firefox",
    "lint:firefox": "node scripts/browsers/web-ext.mjs lint --source-dir dist-firefox --self-hosted --warnings-as-errors",
    "package:firefox": "npm run build:firefox && npm run lint:firefox && node scripts/extension/package.mjs --firefox && node scripts/extension/package-firefox-source.mjs",
    "firefox:run": "node scripts/browsers/web-ext.mjs run --source-dir dist-firefox",
    "firefox:android": "node scripts/browsers/web-ext.mjs run --source-dir dist-firefox --target firefox-android",
    "firefox:sign": "node scripts/release/sign-firefox.mjs",
    "test:firefox": "node --test tests/firefox/extension.test.mjs",
    "test:desktop": "node scripts/browsers/test-desktop.mjs",
    "test:release": "node --test tests/release/*.test.mjs",
    "release": "gh workflow run release.yml"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/starlight": "0.42.0",
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.2.9",
    "@types/node": "22.20.2",
    "astro": "7.3.2",
    "esbuild": "0.28.2",
    "oxlint": "1.82.0",
    "selenium-webdriver": "4.49.0",
    "typescript": "7.0.2",
    "web-ext": "10.6.0",
    "wrangler": "4.131.1"
  },
  "overrides": {
    "addons-linter": {
      "image-size": "2.0.4"
    }
  }
}
