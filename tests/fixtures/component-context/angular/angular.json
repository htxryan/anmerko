{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "component-context-angular": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "",
      "prefix": "fixture",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "main.ts",
            "tsConfig": "tsconfig.json",
            "index": false,
            "aot": true,
            "assets": [],
            "styles": [],
            "scripts": [],
            "polyfills": [],
            "sourceMap": false,
            "outputHashing": "none",
            "extractLicenses": false
          },
          "configurations": {
            "development": {
              "outputPath": "dist/development",
              "optimization": false,
              "define": {
                "BRIEFMARK_ANGULAR_BUILD_MODE": "\"development\"",
                "BRIEFMARK_ANGULAR_OPTIMIZED": "false"
              }
            },
            "production": {
              "outputPath": "dist/production",
              "optimization": true,
              "define": {
                "BRIEFMARK_ANGULAR_BUILD_MODE": "\"production\"",
                "BRIEFMARK_ANGULAR_OPTIMIZED": "true"
              }
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
