{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "briefmark-support",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "briefmark.app/support", "zone_name": "briefmark.app" },
    { "pattern": "briefmark.app/support/*", "zone_name": "briefmark.app" }
  ]
}
