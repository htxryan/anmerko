{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "briefmark-site",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "../artifacts/legacy-site", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "none" },
  "routes": [
    { "pattern": "briefmark.app", "custom_domain": true },
    { "pattern": "www.briefmark.app", "custom_domain": true }
  ]
}
